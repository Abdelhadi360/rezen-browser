{
  "expo": {
    "name": "Rezen",
    "slug": "rezen",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rezen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.abdelhadi360.rezen",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abdelhadi360.rezen"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "./plugins/with-android-widget-launch",
        {
          "widgetNames": [
            "WhimsicalLogoWidget",
            "SearchBarWidget"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "WhimsicalLogoWidget",
              "displayName": "Whimsical Logo",
              "description": "Open Rezen search",
              "ios": null,
              "android": {
                "minWidth": 70,
                "minHeight": 70,
                "targetCellWidth": 2,
                "targetCellHeight": 1,
                "resizeMode": "both",
                "initialLayout": "src/widgets/whimsical-logo-widget.tsx"
              }
            },
            {
              "name": "SearchBarWidget",
              "displayName": "Rezen Search",
              "description": "Search the web with Rezen",
              "ios": null,
              "android": {
                "minWidth": 210,
                "minHeight": 70,
                "targetCellWidth": 3,
                "targetCellHeight": 1,
                "resizeMode": "both",
                "initialLayout": "src/widgets/searchbar-widget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.abdelhadi360.rezen.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.abdelhadi360.rezen"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "70313705-48e8-4771-8835-ec0657f39363"
      }
    },
    "owner": "abdelhadi360"
  }
}
